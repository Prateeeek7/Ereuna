# Ereuna Backend Configuration
# Copy to .env and fill in values

# Database: paste Neon's connection string exactly as Neon shows it, e.g.
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Leave empty to use a local SQLite file (data/researchradar.db) for development.
DATABASE_URL=

# Redis
REDIS_URL=redis://redis:6379/0

# GROBID
GROBID_URL=http://grobid:8070

# Without any LLM the pipeline still runs, using conservative text heuristics
# (no gap synthesis or experiment suggestions).
# LLM providers, tried in order. When one hits its rate or daily limit the
# next one takes over automatically (free tiers stack).
#   cerebras: gpt-oss-120b, 30k tokens/min, 5 req/min, 1M tokens/day (free)
#   groq:     openai/gpt-oss-120b, 8k tokens/min, 1,000 req/day (free)
#   gemini:   GEMINI_MODEL may list several models, tried in order (Flash is often
#             overloaded on the free tier; Flash-Lite is the fallback)
LLM_CHAIN=
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest,gemini-3.5-flash-lite
# Only the top-N ranked papers per map use the LLM (0 = all); the rest use text heuristics.
LLM_MAX_PAPERS=8
LLM_MAX_CONCURRENCY=1

# Single-provider mode (used only when LLM_CHAIN is empty):
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5   LLM_API_KEY=sk-ant-...
#   LLM_PROVIDER=openai     LLM_MODEL=gpt-4o            LLM_API_KEY=sk-...
#   Local Ollama (no key):  LLM_PROVIDER=openai LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=<model>
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_MAX_INPUT_CHARS=60000
LLM_TOKENS_PER_MINUTE=0
LLM_MAX_OUTPUT_TOKENS=2500
LLM_REASONING_EFFORT=

# Paper source API keys
# Free key from openalex.org. Without it, requests share a tiny per-IP daily
# budget and OpenAlex starts returning HTTP 429.
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# Key limit is 1 req/s across all endpoints; 0.9 leaves headroom for timing jitter.
SEMANTIC_SCHOLAR_RPS=0.9
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=
# Unpaywall needs a contact email to find legal open-access PDFs (more full-text papers).
UNPAYWALL_EMAIL=

# Accounts: legacy local accounts file (imported into the database once), token
# signing key (generated and kept in the database when empty),
# and how many new maps each account may start per day (0 = unlimited).
AUTH_DB_PATH=data/users.db
AUTH_SECRET=
MAX_MAPS_PER_USER_PER_DAY=20

# App settings
MAX_PAPERS_DEFAULT=25
CACHE_TTL_DAYS=7
LOG_LEVEL=INFO
